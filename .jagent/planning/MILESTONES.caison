# files, CHANGELOG.md, tags v0.1.0..v0.3.0 and merged PRs #1-#15. ROADMAP/STATE/TASKS stop at 2026-08-25 (v0.1.6) and are stale;
# status below follows the tickets, tags and merged PRs instead.

schema: "milestones/1"

project: {
  name: "mayfly"
  kind: "repo"
