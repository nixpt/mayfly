  summary: "released through v0.3.0 (2026-10-26): CLI, adapters for claude/cursor/codex/opencode/copilot, worktree isolation, hardened local lifecycle, per-project fleet runners; remote adapter and the bro harness are open"
  north_star: "a harness-agnostic launcher for ephemeral single-purpose agents: validate a concrete task, hatch into a harness, watch a mechanical done_when and a hard TTL, tear down, leave only artifacts"
  stewards: ["arisu", "chota"]
  evidence: {
    default_branch: "main"
    registries: []
  }
}

